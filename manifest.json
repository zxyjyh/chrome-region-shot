{
  "manifest_version": 3,
  "name": "Region Shot · 区域截图",
  "version": "1.3.0",
  "description": "在网页上拖拽框选任意范围，拖到边缘可自动滚动，选多长截多长，保存为 PNG。",
  "minimum_chrome_version": "110",
  "permissions": ["activeTab", "scripting", "downloads", "debugger"],
  "action": {
    "default_title": "框选截图 (Alt+Shift+S)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      }
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
