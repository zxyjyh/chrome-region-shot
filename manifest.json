{
  "manifest_version": 3,
  "name": "Region Shot · 区域截图",
  "version": "1.7.0",
  "description": "拖拽定起点，滚动到结束位置，截取任意长页面；在截图上添加文字、箭头、矩形后保存为 PNG。",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "debugger"
  ],
  "action": {
    "default_title": "框选截图 (Alt+Shift+S)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      }
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
